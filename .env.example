# ---- HTTP 服务 ----
PORT=7788
HOST=127.0.0.1

# ---- LLM（OpenAI 兼容；默认接本机 CommandCodeGo 代理） ----
# base URL 要带 /v1，服务端会拼 /chat/completions
LLM_BASE_URL=http://127.0.0.1:3050/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# 图形题用的视觉模型；留空则回退到 LLM_MODEL
LLM_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
# 代理的密钥（user_* 或 sk-ccp-*）。也可在网页「设置」里填写，或留空自动读取本机代理数据库
LLM_API_KEY=

# 并发与批量
LLM_CONCURRENCY=3
LLM_BATCH_SIZE=4
LLM_MAX_TOKENS=16384

# ---- PDF 抽取（PyMuPDF） ----
PYTHON=python
